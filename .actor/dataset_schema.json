{
    "$schema": "https://apify.com/schemas/v1/dataset.ide.json",
    "actorSpecification": 1,
    "fields": {
        "query": "Search query used on Google Maps",
        "title": "Business or company name",
        "category": "Business category",
        "rating": "Google Maps rating (1 to 5)",
        "reviewsCount": "Total reviews count",
        "address": "Physical street address",
        "phone": "Phone number from Google Maps",
        "website": "Company website URL",
        "googleMapsUrl": "Google Maps direct place URL",
        "emails": "Verified direct contact emails extracted from website",
        "phones": "Phone numbers extracted from website and Maps",
        "socials": "Social media profiles (LinkedIn, Instagram, Facebook, Twitter, YouTube, TikTok)",
        "enriched": "Whether deep website crawl succeeded",
        "scrapedAt": "ISO timestamp of extraction"
    },
    "views": {
        "overview": {
            "title": "Overview",
            "transformation": {
                "fields": [
                    "title",
                    "category",
                    "rating",
                    "phone",
                    "emails",
                    "website",
                    "address"
                ]
            },
            "display": {
                "component": "table",
                "properties": {
                    "title": {
                        "label": "Business Name",
                        "format": "text"
                    },
                    "category": {
                        "label": "Category",
                        "format": "text"
                    },
                    "rating": {
                        "label": "Rating",
                        "format": "number"
                    },
                    "phone": {
                        "label": "Phone",
                        "format": "text"
                    },
                    "emails": {
                        "label": "Emails",
                        "format": "text"
                    },
                    "website": {
                        "label": "Website",
                        "format": "link"
                    },
                    "address": {
                        "label": "Address",
                        "format": "text"
                    }
                }
            }
        }
    }
}
